{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "utm": {
        "type": "local",
        "command": [
          "{env:HOME}/.local/bin/uv",
          "--directory",
          "{env:HOME}/repos/clones/utm_mcp",
          "run",
          "utm-mcp",
        ],
      },
      "linear": {
        "type": "remote",
        "url": "https://mcp.linear.app/mcp",
        "disabled": true,
      },
      "linear-personal": {
        "type": "remote",
        "url": "https://mcp.linear.app/mcp",
        "disabled": false,
      },
    },
  },
}
