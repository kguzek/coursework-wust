# 1. Local PostgreSQL (default port 5432)
PG_CONN=postgresql+psycopg2://pbduser:pbdp%40ss@localhost:5437/chinook

# 2. Local MS SQL Server (default port 1433)
MSSQL_CONN=mssql+pymssql://pbduser:pbdp%40ss@156.17.130.187:22433/Chinook

# 3. Local Oracle Database (default port 1521)
ORACLE_CONN=oracle+oracledb://c##pbduser:pbdp%40ss@156.17.130.187:1527/?service_name=FREE

# SYSTEM password of the Oracle container
ORACLE_PWD=Oracle_admin_123
# password of pbduser (used in both Oracle and PostgreSQL)
PBD_PASSWORD=Pbd_pass_123

# host ports
ORACLE_PORT=1527
PG_PORT=5437
