@startuml
title FLAME — model domenowy
left to right direction
hide methods
hide empty members
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam nodesep 50
skinparam ranksep 60

package "Program studiów" {
  class "Plan studiów" as PlanStudiow {
    kierunek
    stopien
    formaStudiow: stacjonarne / niestacjonarne
  }
  class "Instancja planu" as Instancja {
    oznaczenie
  }
  class "Etap" as Etap {
    numer
  }
  class "Kurs" as Kurs {
    kod
    nazwa
    punktyECTS
    ogolny
  }
  class "Forma zajęć" as Forma {
    rodzaj: RodzajZajec
    liczbaGodzin
  }
  enum "RodzajZajec" as RodzajZajec {
    W
    C
    L
    P
    S
  }
}

package "Organizacja dydaktyki" {
  class "Rok akademicki" as Rok {
    oznaczenie
  }
  class "Semestr" as Semestr {
    rodzaj: zimowy / letni
  }
  class "Plan powierzeń" as Plan {
    dataZatwierdzenia [0..1]
    dataPrzekazaniaDoDzialuKsztalcenia [0..1]
  }
  class "Zapotrzebowanie" as Zapotrzebowanie {
    liczbaStudentow
    /przewidywanaLiczbaGrup
    rzeczywistaLiczbaGrup [0..1]
    /liczbaGodzin
  }
  class "Powierzenie zajęć" as Powierzenie {
    liczbaGrup
    liczbaGodzin
  }
  class "Osoba dokonująca powierzeń" as Przydzielajacy {
    imieINazwisko
  }
  class "Dział kształcenia" as Ksztalcenie
}

package "Prowadzący i obciążenie" {
  abstract class "Prowadzący" as Prowadzacy {
    imieINazwisko
    adresEmail
  }
  class "Nauczyciel akademicki" as Nauczyciel
  class "Ekspert zewnętrzny" as Ekspert
  class "Roczne rozliczenie pensum" as Pensum {
    grupaPracownicza: badawczo-dydaktyczna / dydaktyczna
    stanowisko
    wymiarEtatu
    /pensumBazowe
    /pensumPoZnizkach
    /godzinyPowierzone
    /brakujaceGodziny
    /godzinyPonadwymiarowe
  }
  class "Zniżka pensum" as Znizka {
    podstawa
    liczbaGodzin
  }
  class "Preferencja prowadzącego" as Preferencja {
    preferowanaForma: RodzajZajec [0..1]
    opisDostepnosci [0..1]
  }
  class "Kompetencja do prowadzenia kursu" as Kompetencja
}

package "Konsultowanie propozycji" {
  class "Propozycja przydziału" as Propozycja {
    numerWersji
    dataWyslania
    terminOdpowiedzi
    status: wyslana / zaakceptowana / zaakceptowanaMilczaco / zgloszonoZastrzezenia
    dataAkceptacji [0..1]
  }
  class "Pozycja propozycji" as Pozycja {
    kodKursu
    nazwaKursu
    forma: RodzajZajec
    liczbaGrup
    liczbaGodzin
  }
  class "Odpowiedź prowadzącego" as Odpowiedz {
    dataOtrzymania
    tresc
    rodzaj: zgoda / odmowa / prosbaOZmiane
  }
}

PlanStudiow "1" *-- "1..*" Etap
Etap "1..*" -- "1..*" Kurs
Kurs "1" *-- "1..*" Forma
PlanStudiow "1" -- "0..*" Instancja : realizowany jako
Forma -[hidden]- RodzajZajec

Rok "1" *-- "2" Semestr
Semestr "1" -- "0..*" Instancja : semestr rozpoczęcia
Instancja "1" -- "0..*" Plan
Semestr "1" -- "0..*" Plan
Instancja "1" -- "0..*" Zapotrzebowanie
Forma "1" -- "0..*" Zapotrzebowanie
Plan "1" *-- "0..*" Powierzenie
Zapotrzebowanie "1" -- "0..*" Powierzenie
Prowadzacy "1" -- "0..*" Powierzenie : otrzymuje
Przydzielajacy "1..*" -- "0..*" Plan : przygotowuje
Ksztalcenie "1" -- "0..*" Plan : otrzymuje zatwierdzony

Prowadzacy <|-- Nauczyciel
Prowadzacy <|-- Ekspert
Nauczyciel "1" -- "0..*" Pensum
Rok "1" -- "0..*" Pensum
Pensum "1" *-- "0..*" Znizka
Prowadzacy "1" -- "0..*" Preferencja
Semestr "1" -- "0..*" Preferencja
Kurs "0..1" -- "0..*" Preferencja : preferowany kurs
Prowadzacy "1" -- "0..*" Kompetencja
Kurs "1" -- "0..*" Kompetencja

Semestr "1" -- "0..*" Propozycja
Prowadzacy "1" -- "0..*" Propozycja : adresat
Propozycja "1" *-- "1..*" Pozycja
Powierzenie "0..1" -- "0..*" Pozycja : dotyczy
Propozycja "1" -- "0..*" Odpowiedz
@enduml
